---
import { getCollection, type CollectionEntry } from "astro:content";
import ProjectDetailPage from "../../../components/projects/ProjectDetailPage.astro";
import { isSlugForLocale, stripLocaleFromSlug } from "../../../i18n/content";

export async function getStaticPaths() {
  const entries = (await getCollection("projects")).filter((p) => isSlugForLocale(p.slug, "es"));
  return entries.map((entry) => ({
    params: { slug: stripLocaleFromSlug(entry.slug, "es") },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"projects"> };
const { entry } = Astro.props;
---

<ProjectDetailPage entry={entry} locale="es" />
