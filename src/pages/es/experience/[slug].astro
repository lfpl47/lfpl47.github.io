---
import { getCollection } from "astro:content";
import RoleDetailPage from "../../../components/experience/RoleDetailPage.astro";
import { isSlugForLocale, stripLocaleFromSlug } from "../../../i18n/content";

export async function getStaticPaths() {
  const entries = (await getCollection("experience")).filter((e) => isSlugForLocale(e.slug, "es"));
  return entries.map((entry) => ({
    params: { slug: stripLocaleFromSlug(entry.slug, "es") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<RoleDetailPage entry={entry} locale="es" />
