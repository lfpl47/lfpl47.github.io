---
// One role on the Experience index. The company is the only link to the role page.
import DateRange from "./DateRange.astro";
import StackLine from "./StackLine.astro";
import type { CareerRole } from "../lib/getCareer";
import type { Locale } from "../i18n/locales";
import { t, type UiKey } from "../i18n/ui";
import { orderedStack } from "../utils/stack";

type Props = { role: CareerRole; locale: Locale };

const { role, locale } = Astro.props;
const shown = role.highlights.slice(0, 4);
const more = role.highlights.length - shown.length;
---

<article class="xp-entry" id={`role-${role.slug}`}>
  <p class="t-ui t-ui--dense xp-entry__date">
    <DateRange class="date-range--split" start={role.start} end={role.end} locale={locale} />
  </p>
  <div class="xp-entry__main">
    <h3 class="t-h3"><a class="link-quiet" href={role.href}>{role.company}</a></h3>
    <p class="xp-entry__role">
      {role.role}{role.employmentType && <span class="t-meta xp-entry__flag"> · {t(locale, `emp_${role.employmentType}` as UiKey)}</span>}
    </p>
    {role.location && <p class="t-meta xp-entry__flag">{role.location}</p>}
    <ul class="t-body xp-entry__hl">
      {shown.map((h) => <li>{h}</li>)}
    </ul>
    {more > 0 && <p class="xp-entry__more"><a class="link t-ui" href={role.href}>{t(locale, "highlights_more", { n: more })}</a></p>}
  </div>
  {
    orderedStack(role.stack).length > 0 && (
      <div class="xp-entry__stack">
        <p class="t-meta xp-entry__label">{t(locale, "stack")}</p>
        <StackLine stack={role.stack} locale={locale} />
      </div>
    )
  }
</article>

<style>
  .xp-entry { padding-block: var(--s-5); }
  .xp-entry + .xp-entry { border-top: var(--rule-hair) solid var(--rule); }
  .xp-entry__main { margin-top: var(--s-1); }
  .xp-entry__role {
    margin-top: var(--s-1);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 500;
    color: var(--ink-2);
  }
  .xp-entry__flag { color: var(--ink-3); }
  p.xp-entry__flag { margin-top: var(--s-1); }
  .xp-entry__hl { margin-top: var(--s-4); max-width: var(--measure); padding-left: 1.25rem; list-style: "– "; }
  .xp-entry__hl li + li { margin-top: var(--s-2); }
  .xp-entry__more { margin-top: var(--s-3); }
  .xp-entry__stack { margin-top: var(--s-5); }
  .xp-entry__label { margin-bottom: var(--s-1); color: var(--ink-3); }

  @media (min-width: 960px) {
    .xp-entry {
      display: grid;
      grid-template-columns: var(--date-col) minmax(0, 1.6fr) minmax(0, 1fr);
      column-gap: var(--gutter);
      align-items: baseline;
    }
    .xp-entry__main, .xp-entry__stack { margin-top: 0; }
    .xp-entry__stack { border-top: var(--rule-hair) solid var(--rule); padding-top: var(--s-2); }
  }
</style>
