---
import Container from "./Container.astro";
import { site } from "../config/site";
import type { Locale } from "../i18n/locales";
import { otherLocale, withLocale } from "../i18n/routing";
import { t } from "../i18n/ui";

type Props = { locale: Locale; languageSwitch: boolean };

const { locale, languageSwitch } = Astro.props;
const other = otherLocale(locale);
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <Container class="site-footer__row">
    <p class="t-meta site-footer__copy">© {year} {site.name}</p>
    <nav class="t-meta site-footer__nav" aria-label={t(locale, "footer_label")}>
      <a class="link-quiet" href={site.links.email}>{t(locale, "email")}</a>
      <a class="link-quiet" href={site.links.linkedin} target="_blank" rel="noreferrer">
        {t(locale, "linkedin")}<span class="sr-only"> {t(locale, "new_tab")}</span>
      </a>
      <a class="link-quiet" href={site.links.github} target="_blank" rel="noreferrer">
        {t(locale, "github")}<span class="sr-only"> {t(locale, "new_tab")}</span>
      </a>
      {
        languageSwitch && (
          <a class="link-quiet" href={withLocale(Astro.url.pathname, other)} lang={other} hreflang={other}>
            {t(locale, other === "es" ? "lang_es" : "lang_en")}
          </a>
        )
      }
    </nav>
  </Container>
</footer>
