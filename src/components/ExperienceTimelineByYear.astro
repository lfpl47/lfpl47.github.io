---
import ExperienceCard from "./ExperienceCard.astro";
import type { CareerRole } from "../lib/getCareer";
import type { Locale } from "../i18n/locales";

type Props = {
  locale: Locale;
  /** Newest first. */
  roles: CareerRole[];
  navLabel: string;
  emptyText: string;
};

const { locale, roles, navLabel, emptyText } = Astro.props;

const rolesByYear = new Map<number, CareerRole[]>();
for (const role of roles) {
  const year = role.start.getUTCFullYear();
  rolesByYear.set(year, [...(rolesByYear.get(year) ?? []), role]);
}
const years = [...rolesByYear.keys()].sort((a, b) => b - a);
---

{
  years.length ? (
    <div class="grid-12 xp-tl" data-experience-timeline>
      <nav class="xp-years" aria-labelledby="xp-years-label">
        <p class="t-meta xp-years__label" id="xp-years-label">{navLabel}</p>
        <ol class="xp-years__list">
          {years.map((year, index) => (
            <li>
              <a href={`#y-${year}`} data-year-link={String(year)} aria-current={index === 0 ? "true" : undefined}>
                {year}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="xp-tl__years">
        {years.map((year) => (
          <section id={`y-${year}`} class="xp-year rule-section" aria-labelledby={`y-${year}-h`} data-year-marker={String(year)}>
            <h2 class="t-year tnum" id={`y-${year}-h`}>{year}</h2>
            {(rolesByYear.get(year) ?? []).map((role) => (
              <ExperienceCard role={role} locale={locale} />
            ))}
          </section>
        ))}
      </div>

      <script is:inline>
        (() => {
          const root = document.querySelector("[data-experience-timeline]");
          if (!root) return;

          const links = Array.from(root.querySelectorAll("[data-year-link]"));
          const markers = Array.from(root.querySelectorAll("[data-year-marker]"));
          if (!links.length || !markers.length) return;

          // Only the attribute changes; CSS styles [aria-current="true"].
          let current = links[0].getAttribute("data-year-link");
          function setActive(year) {
            if (!year || year === current) return;
            current = year;
            for (const link of links) {
              if (link.getAttribute("data-year-link") === year) link.setAttribute("aria-current", "true");
              else link.removeAttribute("aria-current");
            }
          }

          for (const link of links) {
            link.addEventListener("click", () => setActive(link.getAttribute("data-year-link")));
          }

          if (!("IntersectionObserver" in window)) return;

          // Year sections inside the band at 25-35% of the viewport; the top-most one is current.
          const inBand = new Set();
          const last = markers[markers.length - 1].getAttribute("data-year-marker");
          function update() {
            // A short last year can stay below the band at the page end, so it wins there.
            if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) return setActive(last);
            const top = [...inBand].sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)[0];
            if (top) setActive(top.getAttribute("data-year-marker"));
          }

          const observer = new IntersectionObserver(
            (entries) => {
              for (const e of entries) e.isIntersecting ? inBand.add(e.target) : inBand.delete(e.target);
              update();
            },
            { root: null, rootMargin: "-25% 0px -65% 0px", threshold: 0 },
          );

          for (const marker of markers) observer.observe(marker);
          addEventListener("scroll", update, { passive: true });
        })();
      </script>
    </div>
  ) : (
    <p class="t-body xp-empty">{emptyText}</p>
  )
}

<style>
  .xp-years__label { color: var(--ink-3); }
  .xp-years__list { display: flex; flex-wrap: wrap; gap: 0 var(--s-4); }
  .xp-years a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    text-decoration: none;
  }
  .xp-years a:hover { color: var(--ink); }
  .xp-years a[aria-current="true"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.3em;
  }
  .xp-tl__years { margin-top: var(--s-6); }
  .xp-year + .xp-year { margin-top: var(--s-8); }
  .xp-year h2 { margin-bottom: var(--s-1); }
  .xp-empty { color: var(--ink-2); }

  @media (max-width: 959px) {
    /* The row gap keeps a focus ring off the label when the years wrap under it. */
    .xp-years { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); }
  }

  @media (min-width: 960px) {
    .xp-years {
      grid-column: 1 / span 2;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
    .xp-years__label { padding-bottom: var(--s-2); border-bottom: var(--rule-hair) solid var(--ink); }
    .xp-years__list { display: grid; gap: var(--s-2); margin-top: var(--s-3); }
    .xp-years a {
      display: flex;
      min-height: 24px;
      padding-left: 12px;
      font-size: 1.25rem;
    }
    .xp-years a[aria-current="true"] { text-decoration: none; box-shadow: inset 3px 0 0 var(--ink); }
    .xp-tl__years { grid-column: 3 / -1; margin-top: 0; }
  }
</style>
