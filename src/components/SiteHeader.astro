---
import { getCollection } from "astro:content";
import Container from "./Container.astro";
import { site } from "../config/site";
import { isSlugForLocale } from "../i18n/content";
import type { Locale } from "../i18n/locales";
import { otherLocale, withLocale } from "../i18n/routing";
import { t } from "../i18n/ui";

type Props = { locale: Locale; languageSwitch: boolean };

const { locale, languageSwitch } = Astro.props;
const raw = Astro.url.pathname;
const pathname = raw.endsWith("/") ? raw : `${raw}/`;
const other = otherLocale(locale);

// Projects stays out of the nav until the collection has an entry in this language.
const hasProjects = (await getCollection("projects")).some((p) => isSlugForLocale(p.slug, locale));

const homeHref = withLocale("/", locale);
const nav = [
  { href: homeHref, label: t(locale, "nav_home") },
  { href: withLocale("/experience/", locale), label: t(locale, "nav_experience") },
  ...(hasProjects ? [{ href: withLocale("/projects/", locale), label: t(locale, "nav_projects") }] : []),
  { href: withLocale("/training/", locale), label: t(locale, "nav_training") },
  { href: withLocale("/cv/", locale), label: t(locale, "nav_cv") },
];
const current = (href: string) =>
  (href === homeHref ? pathname === homeHref : pathname.startsWith(href)) ? "page" : undefined;
const profiles = [
  { href: site.links.github, label: t(locale, "github") },
  { href: site.links.linkedin, label: t(locale, "linkedin") },
];
// Day or night view: rendered in the desktop row and in the menu; the script shows it and keeps both in step.
const schemes = [
  { value: "light", label: t(locale, "view_day") },
  { value: "dark", label: t(locale, "view_night") },
];
---

<header class="site-header">
  <Container class="site-header__row">
    <a class="wordmark" href={homeHref}>{site.shortName}</a>
    <nav class="site-nav" aria-label={t(locale, "nav_label")}>
      {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
    </nav>
    <div class="site-aux">
      {
        languageSwitch && (
          <a href={withLocale(raw, other)} lang={other} hreflang={other}>
            {t(locale, other === "es" ? "lang_es" : "lang_en")}
          </a>
        )
      }
      {
        profiles.map((p) => (
          <a class="site-aux__ext" href={p.href} target="_blank" rel="noreferrer">
            {p.label}<span class="sr-only"> {t(locale, "new_tab")}</span>
          </a>
        ))
      }
      <div class="view" role="group" aria-label={t(locale, "view_label")} data-view hidden>
        {schemes.map((s) => <button type="button" name="scheme" value={s.value} aria-pressed="false">{s.label}</button>)}
        <button type="button" name="motion" aria-pressed="false">{t(locale, "bg_pause")}</button>
      </div>
    </div>
    <details class="menu" data-menu>
      <summary>{t(locale, "menu")}</summary>
      <div class="menu__panel">
        <nav class="menu__nav" aria-label={t(locale, "nav_label")}>
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
        </nav>
        <div class="menu__ext">
          {
            profiles.map((p) => (
              <a href={p.href} target="_blank" rel="noreferrer">
                {p.label}<span class="sr-only"> {t(locale, "new_tab")}</span>
              </a>
            ))
          }
        </div>
        <div class="view" role="group" aria-label={t(locale, "view_label")} data-view hidden>
          {schemes.map((s) => <button type="button" name="scheme" value={s.value} aria-pressed="false">{s.label}</button>)}
          <button type="button" name="motion" aria-pressed="false">{t(locale, "bg_pause")}</button>
        </div>
      </div>
    </details>
  </Container>
</header>
<script is:inline>
  (() => {
    const menu = document.querySelector("[data-menu]");
    if (!menu) return;
    const summary = menu.querySelector("summary");
    const close = (refocus) => { if (!menu.open) return; menu.open = false; if (refocus) summary.focus(); };
    menu.addEventListener("keydown", (e) => { if (e.key === "Escape") close(true); });
    menu.addEventListener("focusout", (e) => { if (!menu.contains(e.relatedTarget)) close(false); });
    document.addEventListener("click", (e) => { if (!menu.contains(e.target)) close(false); });
    for (const a of menu.querySelectorAll("a")) a.addEventListener("click", () => close(false));
  })();
</script>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const key = "lfpl47-scheme";
    const system = matchMedia("(prefers-color-scheme: dark)");
    // Only the scheme buttons: a later button in the same group (the background pause) keeps its own state.
    const buttons = document.querySelectorAll('[data-view] [name="scheme"]');
    // Pressed = the scheme in effect: the visitor's choice, else the system setting.
    const sync = () => {
      const scheme = root.dataset.theme || (system.matches ? "dark" : "light");
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.value === scheme));
      if (root.dataset.theme) for (const m of document.querySelectorAll("meta[data-scheme]")) m.media = m.dataset.scheme === scheme ? "all" : "not all";
    };
    // Holds color transitions for two frames (global.css), so the switch is the cross-fade or instant.
    const hold = () => {
      root.dataset.switching = "";
      requestAnimationFrame(() => requestAnimationFrame(() => delete root.dataset.switching));
    };
    const choose = (scheme) => {
      hold();
      root.dataset.theme = scheme;
      try { localStorage.setItem(key, scheme); } catch {}
      sync();
    };
    for (const b of buttons) {
      b.addEventListener("click", () => {
        const fade = b.getAttribute("aria-pressed") === "false" && document.startViewTransition && matchMedia("(prefers-reduced-motion: no-preference)").matches;
        if (fade) document.startViewTransition(() => choose(b.value));
        else choose(b.value);
      });
    }
    // A system switch is instant too; with a stored choice the scheme does not change, so there is nothing to hold.
    system.addEventListener("change", () => { if (!root.dataset.theme) hold(); sync(); });
    // A page restored from the back-forward cache keeps the scheme it was left with; take the stored one.
    addEventListener("pageshow", (e) => {
      if (!e.persisted) return;
      try {
        const stored = localStorage.getItem(key);
        if ((stored === "light" || stored === "dark") && stored !== root.dataset.theme) { hold(); root.dataset.theme = stored; }
      } catch {}
      sync();
    });
    sync();
    for (const g of document.querySelectorAll("[data-view]")) g.hidden = false;
  })();
</script>
<script is:inline>
  (() => {
    // Background pause (public/site-bg.js): one fixed label, pressed = paused (WAI-ARIA APG: a toggle's label does not
    // change), stored in lfpl47-motion. global.css hides the button where the city does not move (reduced motion, forced
    // colors, more contrast, print).
    const key = "lfpl47-motion";
    const buttons = document.querySelectorAll('[data-view] [name="motion"]');
    const stored = () => { try { return localStorage.getItem(key) === "paused"; } catch { return false; } };
    // site-bg.js is deferred: on the first call it is not there yet, and it reads the stored state itself.
    const apply = (paused) => {
      if (paused) window.siteBg?.pause(); else window.siteBg?.play();
      for (const b of buttons) b.setAttribute("aria-pressed", String(paused));
    };
    for (const b of buttons) {
      b.addEventListener("click", () => {
        const paused = b.getAttribute("aria-pressed") === "false";
        try { if (paused) localStorage.setItem(key, "paused"); else localStorage.removeItem(key); } catch {}
        apply(paused);
      });
    }
    // A page restored from the back-forward cache keeps its old loop state; take the stored one.
    addEventListener("pageshow", (e) => { if (e.persisted) apply(stored()); });
    apply(stored());
  })();
</script>
